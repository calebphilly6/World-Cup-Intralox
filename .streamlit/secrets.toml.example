# Copy to .streamlit/secrets.toml for local development.
# In Streamlit Community Cloud, paste these values into the app's Secrets panel.
# Never commit .streamlit/secrets.toml.

THE_ODDS_API_KEY = "replace-with-the-odds-api-key"
BALLDONTLIE_API_KEY = "replace-with-balldontlie-api-key"
FOOTBALL_DATA_API_KEY = "replace-with-football-data-api-key"

# Leave blank to disable the password gate.
APP_PASSWORD = ""

# Set true when sharing a hosted app.
# This protects official/core World Cup data while allowing personal preferences.
SHARED_CORE_READ_ONLY_MODE = false

# Backward-compatible old name. Prefer SHARED_CORE_READ_ONLY_MODE above.
SHARED_READ_ONLY_MODE = false

[odds]
sport_key = ""
regions = "us"
bookmakers = ""
